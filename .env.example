# Copia questo file come riferimento. Su Railway NON si carica questo file:
# le variabili si inseriscono direttamente nell'interfaccia web (tab "Variables").

# Token del bot Telegram "Vinted Notification" (@VintedGnimaBot)
# Ottenuto da @BotFather. RIGENERALO prima di metterlo qui, visto che il
# token originale e' stato condiviso in chiaro in chat.
TELEGRAM_BOT_TOKEN=

# Il TUO chat id personale (dove il bot ti manda i report in privato).
# Per scoprirlo: scrivi /start al bot @VintedGnimaBot in chat privata,
# poi visita https://api.telegram.org/bot<TOKEN>/getUpdates
# e leggi il campo "chat":{"id": ...} del tuo messaggio.
TELEGRAM_OWNER_CHAT_ID=

# L'id del gruppo "Dadegnima, Vinted Notific..." da ascoltare.
# Per scoprirlo: scrivi un messaggio qualsiasi nel gruppo, poi visita
# https://api.telegram.org/bot<TOKEN>/getUpdates
# Il chat id dei gruppi e' un numero NEGATIVO (es. -1001234567890).
TELEGRAM_GROUP_ID=

# Chiave API Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Chiave API Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
