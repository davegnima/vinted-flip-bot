# Solo i NOMI delle variabili Railway del worker, con il default del codice dove c'e'.
# Su Railway le variabili si inseriscono nella tab "Variables". Mai scrivere valori segreti qui.

# --- Obbligatorie ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=      # generata con generate_session.py, equivale a un login: non condividerla
TELEGRAM_BOT_TOKEN=           # bot che invia i report
TELEGRAM_OWNER_CHAT_ID=       # chat privata dell'utente
TELEGRAM_GROUP_ID=            # gruppo del tracker (negativo, -100...)
GEMINI_API_KEY=               # obbligatoria (ripiego se GEMINI_API_KEYS e' vuota); la riserva a pagamento e' stata tolta il 23/10

# --- Gemini e riserva ---
GEMINI_API_KEYS=              # chiavi gratuite separate da virgola
GEMINI_CASCATA=  GEMINI_CASCATA_OCCHIO=
GEMINI_PAUSA_429_SECONDI=300  GEMINI_BACKOFF_MAX_S=6  GEMINI_BUDGET_CHIAMATA_S=60
GEMINI_TIMEOUT_PER_PAUSA=2  GEMINI_PAUSA_TIMEOUT_SECONDI=120

# --- Rete e ricerca ---
PROXY_LIST=  PROXY_ESCLUSI=   # non modificare senza ok dell'utente
PAGINA_LEGGERA_MAX_CARATTERI=60000  PAGINA_LEGGERA_RETRY=2

# --- Preavviso, tracciamento, radar ---
TELEGRAM_ALERT_CHAT_ID=  PREAVVISO_ATTIVO=1
TRACCIAMENTO_ATTIVO=1
RADAR_TRACCIA_ROSSI_1_SU=10   # tracciamento vendite v2: gialli e verdi sempre, rossi 1 ogni N (0 = nessuno)
RADAR_ATTIVO=1  RADAR_GROUP_ID=  RADAR_MARCATORE=📡  RADAR_PREZZO_MIN=10  RADAR_RICONTROLLI_SECONDI=60,900,3600
RADAR_BRAND_SILENZIO=gopro,dji   # brand con avviso silenziato (tracciamento attivo)
RADAR_CHAT_ID=  RADAR_SEMAFORI=verde,giallo   # chat degli avvisi radar (default: TELEGRAM_OWNER_CHAT_ID, la chat del Cervello); solo questi semafori

# --- Dati su volume ---
DB_FILE=/data/vinted_bot.sqlite3
PREAVVISO_GIALLO_PREZZO_MAX=15
ARRESTO_ATTESA_MAX_S=90
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=100
RADAR_GEMINI=1  RADAR_GEMINI_MAX_ORA=40  RADAR_GEMINI_FOTO=10
MODA_JEV_SUBITO=1
MODA_JEV_MARGINE_MIN=40
MODA_GEMINI=1
PREAVVISO_DA_VERIFICARE=1
PREAVVISO_DA_VERIFICARE_MARGINE=50
MODA_GEMINI_MAX_ORA=30
MODA_GEMINI_FOTO=8
MODA_JEV_DISPERSIONE_MAX=
MODA_JEV_OMBRA=
MODA_JEV_OMBRA_MAX_ORA=
LEGIT_APPRESO_FILE=
VELOCITA_APPRESA_FILE=/data/velocita.json
MODA_JEV_OMBRA_CAMPIONI_MIN=
MODA_COMPS_ORDINE=
MODA_COMPS_PROVA=
PREAVVISO_MARGINE_ASSOLUTO_MIN=
VENDUTO_VELOCE_MARGINE_MIN=
