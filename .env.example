# Solo i NOMI delle variabili Railway del worker, con il default del codice dove c'e'.
# Su Railway le variabili si inseriscono nella tab "Variables". Mai scrivere valori segreti qui.

# --- Obbligatorie ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=      # generata con generate_session.py, equivale a un login: non condividerla
TELEGRAM_BOT_TOKEN=           # bot che invia i report
TELEGRAM_OWNER_CHAT_ID=       # chat privata dell'utente
TELEGRAM_GROUP_ID=            # gruppo del tracker (negativo, -100...)
GEMINI_API_KEY=               # chiave Google A PAGAMENTO (ultima riserva); distinta da GEMINI_API_KEYS

# --- Gemini e riserva ---
GEMINI_API_KEYS=              # chiavi gratuite separate da virgola
GEMINI_CASCATA_OCCHIO=  GEMINI_CASCATA_OCCHIO_ALTO=  GEMINI_CASCATA_CERVELLO=  GEMINI_CASCATA_CERVELLO_ALTO=
GEMINI_PAUSA_429_SECONDI=300  GEMINI_BACKOFF_MAX_S=6  GEMINI_BUDGET_CHIAMATA_S=60
GEMINI_TIMEOUT_PER_PAUSA=2  GEMINI_PAUSA_TIMEOUT_SECONDI=120  GEMINI_SOGLIA_PREZZO_ALTO=50
GEMINI_MODELLO_PAGAMENTO=     # default gemini-3.1-flash-lite
PAGAMENTO_MAX_RICHIESTE_GIORNO=600
EXTRA_LLM_URL=  EXTRA_LLM_KEY=  EXTRA_LLM_MODEL=   # gateway OmniRoute
RISERVA_OCCHIO_MODELLI=  RISERVA_CERVELLO_MODELLI=  RISERVA_LENTA_MS=20000  RISERVA_LENTA_PAUSA_S=600
PANEL_OCCHIO_MODELLI=  PANEL_CERVELLO_MODELLI=  PANEL_MODELLI_PER_ANNUNCIO=0
CERVELLO_CAMPIONI_EXTRA=1  SALTA_CERVELLO_ROSSO=1

# --- Rete e ricerca ---
PROXY_LIST=  PROXY_ESCLUSI=   # non modificare senza ok dell'utente
SERPER_API_KEY=
PAGINA_LEGGERA_MAX_CARATTERI=60000  PAGINA_LEGGERA_RETRY=2

# --- Preavviso, tracciamento, radar ---
TELEGRAM_ALERT_CHAT_ID=  PREAVVISO_ATTIVO=1
TRACCIAMENTO_ATTIVO=1
RADAR_GROUP_ID=  RADAR_MARCATORE=📡  RADAR_PREZZO_MIN=10  RADAR_RICONTROLLI_SECONDI=60,900,3600

# --- Dati su volume ---
DB_FILE=/data/vinted_bot.sqlite3
