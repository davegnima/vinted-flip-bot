# Variabili d'ambiente del worker Railway: nomi e default letti dal codice (tools/controlla_env.py).
# Mai valori segreti qui: chiavi, token, cookie e proxy restano vuoti. Su Railway: tab Variables.
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS (100) e' una variabile di Railway, non letta dal codice: deve restare sopra ARRESTO_ATTESA_MAX_S.

# --- Telegram ---
TELEGRAM_API_ID=   # obbligatoria: api id dell'userbot
TELEGRAM_API_HASH=   # obbligatoria: api hash dell'userbot
TELEGRAM_SESSION_STRING=   # obbligatoria: sessione Telethon, equivale a un login
TELEGRAM_BOT_TOKEN=   # obbligatoria: bot che invia i messaggi
TELEGRAM_OWNER_CHAT_ID=   # obbligatoria: chat privata dell'utente
TELEGRAM_GROUP_ID=   # obbligatoria: gruppo del tracker moda (-100...)
TELEGRAM_ALERT_CHAT_ID=   # gruppo COMPRA degli avvisi (vuoto = chat principale)
TELEGRAM_MSG_MINUTO=14   # limitatore: messaggi al minuto verso un gruppo
TELEGRAM_ATTESA_MUTI_MAX_S=3   # attesa massima (s) per i messaggi muti nel limitatore
FEEDBACK_ATTIVO=1   # bottoni di feedback sugli avvisi (0 = spenti)
WATCHDOG_MINUTI=10   # riavvio se il gruppo tracker tace (0 = spento)
BLOCCO_SECONDI=120   # riavvio se il ciclo e' bloccato (0 = spento)
ARRESTO_ATTESA_MAX_S=90   # attesa massima (s) delle analisi in corso allo stop
REPORT_RADAR_ORA_UTC=5   # ora UTC del report giornaliero del radar

# --- Gemini (gratuito) ---
GEMINI_API_KEY=   # chiave singola, ripiego se GEMINI_API_KEYS e' vuota
GEMINI_API_KEYS=   # chiavi gratuite separate da virgola
GEMINI_CASCATA=   # modelli in ordine, separati da virgola (vuoto = default)
GEMINI_CASCATA_OCCHIO=   # cascata per le chiamate sulle foto (vuoto = generica)
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite   # modello di ripiego
GEMINI_BACKOFF_MAX_S=6   # backoff massimo (s) tra i tentativi
GEMINI_BUDGET_CHIAMATA_S=60   # budget totale (s) per chiamata
GEMINI_TIMEOUT_S=20   # timeout (s) di una singola richiesta
GEMINI_TIMEOUT_PER_PAUSA=2   # timeout di fila prima di sospendere la fase
GEMINI_PAUSA_TIMEOUT_SECONDI=120   # durata (s) della sospensione dopo i timeout

# --- Jev (TypeSafe, a budget) ---
TYPESAFE_API_KEY=   # chiave Jev
JEV_GIUDICE=0   # giudizio sul modello (ombra)
JEV_COMPS=0   # giudizio per singolo comparabile (ombra)
JEV_FOTO_COMPS=0   # confronto foto coi comparabili (ombra)
JEV_PRECONTROLLO=1   # precontrollo di Jev prima del giudizio
JEV_AUTENTICITA_FOTO=5   # foto massime inviate per l'autenticita'

# --- Moda: semaforo e preavviso ---
FAIR_VALUE_LIVELLO_DEFAULT=45   # livello di rivendita se il brand e' ignoto (EUR)
FAIR_VALUE_TARATURA_GLOBALE=1.2   # fattore sulle voci non apprese
FAIR_VALUE_TARATURA_BRAND=   # fattori per brand; vuoto = default del codice (Missoni, Cucinelli, Prada: docs/pipeline.md)
FAIR_VALUE_RIGORE_BASSA=1.0   # moltiplicatore soglie a confidenza bassa
FAIR_VALUE_ROI_VERDE=200   # ROI minimo (%) del verde
FAIR_VALUE_ROI_GIALLO=100   # ROI minimo (%) del giallo
FAIR_VALUE_MARGINE_MIN_VERDE=20   # margine minimo (EUR) del verde
FAIR_VALUE_FILTRA=0   # scarta in anticipo chi ha ROI basso (0 = no)
FAIR_VALUE_FILTRA_ROI_MIN=30   # ROI sotto cui scarta, se il filtro e' attivo
FAIR_VALUE_APPRESO_FILE=/data/fair_value_appreso.json   # file del fair value appreso (volume)
FAIR_VALUE_LOG_FILE=/data/fair_value_log.jsonl   # log delle stime (volume)
CATALOGO_CATEGORIE_FILE=/data/catalogo_categorie.json   # mappa categorie imparata (volume)
PREAVVISO_ATTIVO=1   # preavviso nel gruppo COMPRA (0 = spento)
PREAVVISO_LAMPO=1   # preavviso prima dello scrape con la foto del tracker
PREAVVISO_MARGINE_MIN=25   # margine rapido minimo (EUR)
PREAVVISO_MARGINE_BASSO=20   # margine minimo (EUR) per i prezzi bassi
PREAVVISO_PREZZO_BASSO=20   # prezzo (EUR) sotto cui vale il margine basso
PREAVVISO_MARGINE_NUOVI=50   # margine minimo (EUR) per brand nuovi
PREAVVISO_MARGINE_FACILI=10   # margine minimo (EUR) per i brand facili
PREAVVISO_MARGINE_ASSOLUTO_MIN=40   # margine minimo (EUR) in assoluto
PREAVVISO_BRAND_ESCLUSI=acne studios,marni,lancel   # brand esclusi, separati da virgola
PREAVVISO_BRAND_FACILI=jean paul gaultier   # brand facili, separati da virgola
PREAVVISO_PREZZO_MAX_BRAND=max mara:8   # tetto di prezzo per brand, brand:prezzo
PREAVVISO_GIALLO_PREZZO_MAX=15   # giallo fino a questo prezzo manda sempre (0 = no)
PREAVVISO_SUONO_MARGINE_MIN=40   # preavviso con margine >= questo e ROI >= PREAVVISO_SUONO_ROI_MIN suona (0 = no)
PREAVVISO_SUONO_ROI_MIN=100   # ROI minimo (%) per il suono
PREAVVISO_ROTAZIONE_MARGINE_MIN=30   # brand che ruotano in fretta: margine minimo ridotto (0 = spento)
PREAVVISO_ROTAZIONE_ROI_MIN=100   # ROI minimo (%) per la rotazione veloce
PREAVVISO_ROTAZIONE_LIFT_MIN=1.3   # lift di velocita' minimo del brand (velocita.json)
PREAVVISO_SUONO_RAPPORTO_MIN=4   # rapporto fair value/prezzo per il suono
PREAVVISO_SUONO_VERDE=1   # ogni verde suona (0 = no)
PREAVVISO_DA_VERIFICARE=1   # avviso 'da verificare' per chi non supera il semaforo
PREAVVISO_DA_VERIFICARE_MARGINE=50   # margine minimo (EUR) del 'da verificare'
PREAVVISO_TUTTI_A_JEV=1   # manda tutti gli avvisi a Jev
PREAVVISO_ROSSI_A_JEV=max mara,jean paul gaultier   # brand i cui rossi vanno comunque a Jev
LAMPO_SENZA_CATEGORIA_MARGINE_MIN=50   # margine minimo (EUR) del lampo senza categoria
VELOCITA_ATTIVA=1   # semaforo corretto dalla velocita' (0 = spento)
VELOCITA_FILE=bot/dati/velocita.json   # tabella velocita' del repo
VELOCITA_APPRESA_FILE=/data/velocita.json   # tabella velocita' aggiornata (volume)
VELOCITA_K=10   # peso della restrizione verso la media
VELOCITA_VERDE_X=1.6   # verde da questa volta la velocita' media
VELOCITA_GIALLO_X=0.8   # giallo da questa volta la velocita' media
VELOCITA_SOGLIA_VERDE=   # soglia fissa del verde (vuoto/0 = proporzionale)
VELOCITA_SOGLIA_GIALLO=   # soglia fissa del giallo (vuoto/0 = proporzionale)
VELOCITA_PREZZO_NEUTRO=20   # sotto questo prezzo (EUR) il lift lento non si applica
VELOCITA_SOLO_ROSSO=1   # il lift basso agisce solo sui rossi

# --- Moda: Jev e Gemini ---
MODA_JEV=1   # Jev sui comparabili della moda (letta una volta in config.py, default 1)
MODA_JEV_TUTTI=0   # verifica tutti gli avvisi, non solo i brand nuovi
MODA_JEV_SUBITO=1   # avviso subito, poi aggiornato con l'esito Jev
MODA_JEV_MAX_GIORNO=600   # verifiche Jev massime al giorno
MODA_JEV_MARGINE_MIN=40   # margine minimo (EUR) sotto cui Jev scarta
MODA_JEV_DISPERSIONE_MAX=2.5   # rapporto p75/p25 massimo dei comparabili (0 = spento)
MODA_JEV_OMBRA=1   # prova in ombra sui comparabili
MODA_JEV_OMBRA_MAX_ORA=20   # tetto orario della prova in ombra
MODA_JEV_OMBRA_CAMPIONI_MIN=5   # campioni minimi della prova in ombra
MODA_COMPS_ORDINE=newest_first   # ordine dei comparabili cercati
MODA_COMPS_PROVA=   # ordini alternativi da provare, separati da virgola
LEGIT_APPRESO_FILE=/data/legit_appreso.jsonl   # legit check appresi (volume)
MODA_GEMINI=1   # controllo Gemini sulle foto (0 = spento)
MODA_GEMINI_SEMPRE=1   # controllo su ogni avviso, non solo se Jev dubita
MODA_GEMINI_MAX_ORA=60   # chiamate Gemini massime all'ora
MODA_GEMINI_FOTO=8   # foto massime per chiamata
MODA_GEMINI_REGOLE_PREZZO=1   # regole di prezzo nel prompt (0 = tolte)
COMPS_COND_SCALA=1   # scala della correzione per condizione (0 = nessuna)
VENDUTO_VELOCE_MARGINE_MIN=40   # margine minimo (EUR) del messaggio venduto veloce (0 = spento)
MIUMIU_TOP_PREZZO_MAX=0   # tetto prezzo top Miu Miu scartati (0 = tutti)
TOP_FALSI_PREZZO_MAX=60   # tetto prezzo maglie leggere scartate (0 = spento)

# --- Radar: filtro, matrice, avviso ---
RADAR_ATTIVO=1   # interruttore generale (0 = messaggi ignorati)
RADAR_MARCATORE=📡   # emoji che marca i messaggi del tracker radar
RADAR_GROUP_ID=   # id del gruppo radar (vuoto = cerca per titolo)
RADAR_GROUP_TITOLO=Radar grezzo   # titolo del gruppo radar da cercare
RADAR_CHAT_ID=   # chat degli avvisi (vuoto = gruppo COMPRA, poi owner)
RADAR_SEMAFORI=verde,giallo   # semafori che producono un avviso
RADAR_SOLO_VERDI=0   # 1 = solo verdi (variabile vecchia)
RADAR_MOSTRA_TUTTI=1   # modelli della matrice anche rossi al chat privato
RADAR_BRAND_SILENZIO=gopro,dji   # brand con avviso muto, separati da virgola
RADAR_RISPOSTA_GRUPPO=1   # risposta nel gruppo all'avviso
RADAR_CANCELLA_ROSSI=1   # cancella i messaggi dei rossi
RADAR_CANCELLA_SCARTI=1   # cancella i messaggi degli scartati
RADAR_PREZZO_MIN=10   # prezzo minimo (EUR) del livello 1
RADAR_SPESA_MAX=50   # spesa massima per pezzo (EUR, 0 = nessun tetto)
RADAR_MARGINE_MIN=50   # margine minimo (EUR)
RADAR_ROI_MIN=100   # ROI minimo (%)
RADAR_RISERVA_PER_PUNTO=0.03   # riserva sul buy max per punto di rischio
RADAR_TOLLERANZA_BUY_MAX=1.15   # tolleranza sul buy max della matrice
RADAR_MATRICE_PERCORSO=   # percorso alternativo della matrice (vuoto = data/radar_matrice.json)
RADAR_CAMPIONE_SCARTI_OGNI=10   # 1 scartato ogni N visitato lo stesso (0 = nessuno)
RADAR_MAX_PARALLELO=4   # analisi radar in parallelo
RADAR_PAUSA_DA=23   # inizio pausa notturna (ora italiana, vuoto = nessuna)
RADAR_PAUSA_A=6   # fine pausa notturna (ora italiana)
RADAR_RICONTROLLI_SECONDI=60,300,900,3600   # secondi dei ricontrolli, separati da virgola
RADAR_TRACCIA_ROSSI_1_SU=10   # traccia 1 rosso ogni N (0 = nessuno)
RADAR_AUDIT_1_SU=20   # audit di 1 scarto 'non oggetto' ogni N (0 = nessuno)
RADAR_FAMIGLIE_NUOVE_ORA=40   # valutazioni orarie massime delle famiglie nuove
RADAR_APPRESO=1   # apprendimento dei modelli senza resa (0 = spento)
RADAR_APPRESO_GIORNI=14   # finestra (giorni) dell'appreso
RADAR_APPRESO_CAMPIONE=10   # 1 annuncio su N passa comunque (0 = mai)

# --- Radar: comparabili, Jev, Gemini ---
RADAR_V2_OMBRA=0   # radar v2 solo in ombra
RADAR_V2_MAX_GIORNO=3000   # valutazioni v2 massime al giorno
RADAR_V2_CACHE_ORE=24   # validita' (ore) della cache dei prezzi
RADAR_V2_PARALLELO=2   # ricerche comparabili in parallelo
RADAR_V2_PREFILTRO=1   # pre-filtro per ricerca (0 = spento)
RADAR_V2_RIF_ORE=8   # ore di validita' del prezzo di riferimento
RADAR_V2_SCALA_MIN=3   # comparabili minimi prima di allargare la ricerca (0 = no)
RADAR_QUASI_ROI_MIN=90   # ROI minimo (%) del giallo quasi_roi (0 = spento)
RADAR_QUASI_ROI_JEV_CONF=0.85   # confidenza minima di Jev per quasi_roi
RADAR_QUASI_ROI_MIN_N=8   # comparabili minimi per quasi_roi
RADAR_JEV_SOLO_UTILI=1   # Jev solo su gialli, verdi e quasi_roi (0 = tutti)
RADAR_JEV_RICHIESTO=1   # Jev richiesto per l'avviso
RADAR_JEV_CONF_MIN=0.7   # confidenza minima di Jev
RADAR_VERIFICA=1   # verifica dei comparabili 'stesso modello'
RADAR_VERIFICA_SCARTA=0   # 1 = senza simili scarta, 0 = giallo muto
RADAR_GEMINI=1   # controllo Gemini sulle foto (0 = spento)
RADAR_GEMINI_FOTO=10   # foto massime per chiamata
RADAR_GEMINI_MAX_ORA=40   # chiamate Gemini massime all'ora
RADAR_GEMINI_RAPPORTO_MIN=0.5   # rapporto minimo tra stima Gemini e quella del codice

# --- Vinted e proxy ---
PROXY_LIST=   # proxy del worker, non toccare
PROXY_ESCLUSI=   # proxy esclusi, non toccare
PROXY_QUARANTENA_SOGLIA=3   # errori di fila prima della quarantena
PROXY_QUARANTENA_ORE=3   # ore di quarantena di un proxy
SONDA_BANDA_CAMPIONI=10   # pagine misurate dalla sonda banda (0 = spenta)
PAGINA_LEGGERA_MAX_CARATTERI=60000   # sotto questa lunghezza la pagina e' leggera
PAGINA_LEGGERA_RETRY=2   # ritentativi su una pagina leggera
FOTO_DIRETTE=1   # scarico diretto delle foto (0 = spento)
VINTED_API=1   # API Vinted (0 = solo scraping HTML)
VINTED_ACCESS_TOKEN=   # token Vinted, segreto
VINTED_REFRESH_TOKEN=   # token di rinnovo Vinted, segreto
VINTED_COOKIES_EXTRA=   # cookie aggiuntivi, segreto
VINTED_ATTESA_403_S=1   # attesa (s) dopo un 403
VISUAL_SEARCH_ATTIVA=false   # ricerca visuale (true/false)
SPEDIZIONE_TARIFFE=   # tariffe di spedizione alternative (vuoto = default)

# --- Tracciamento ---
TRACCIAMENTO_ATTIVO=1   # tracciamento vendite (0 = spento)
TRACCIAMENTO_FILE=/data/tracciamento_esiti.jsonl   # file degli esiti (volume)
SKIP_GIA_VENDUTI=0   # scarta annunci gia' venduti
ALLARME_PREF_ATTIVO=1   # allarme per preferiti in crescita (0 = spento)
ALLARME_PREF_60=3   # preferiti a 60 s per l'allarme
ALLARME_PREF_300=6   # preferiti a 300 s per l'allarme
ALLARME_PREF_RAPPORTO=1.5   # rapporto fair value/prezzo minimo per l'allarme

# --- Varie ---
DB_FILE=/data/vinted_bot.sqlite3   # database SQLite (volume)
LOG_DB=1   # log nel database (0 = spento)
LOG_DB_MAX_MB=0   # limite in MB del log nel DB (0 = nessuno)
RAILWAY_GIT_COMMIT_SHA=   # impostata da Railway (versione del bot), non toccare
